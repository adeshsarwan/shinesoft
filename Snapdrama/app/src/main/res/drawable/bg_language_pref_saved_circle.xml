<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Black shadow behind circle -->
    <item
        android:bottom="0dp"
        android:left="6dp"
        android:right="0dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="#99000000" />
        </shape>
    </item>

    <item
        android:bottom="2dp"
        android:left="4dp"
        android:right="2dp"
        android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="#66000000" />
        </shape>
    </item>

    <!-- Black fill + white border -->
    <item
        android:bottom="6dp"
        android:left="2dp"
        android:right="4dp"
        android:top="0dp">
        <shape android:shape="oval">
            <solid android:color="#FF000000" />
            <stroke
                android:width="2.5dp"
                android:color="@color/white" />
        </shape>
    </item>

</layer-list>
