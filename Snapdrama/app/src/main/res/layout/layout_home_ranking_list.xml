<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:padding="@dimen/_5sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_height="wrap_content">



    <androidx.cardview.widget.CardView
        android:id="@+id/cardLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_190sdp"
        android:elevation="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/black"
        app:cardCornerRadius="@dimen/_7sdp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <RelativeLayout
                android:id="@+id/mainLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imageSeries"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop" />
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradiant_border"
                    android:rotation="180" />
                <TextView
                    android:id="@id/textCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="@dimen/_4sdp"
                    android:background="@drawable/background_back_category3"
                    android:fontFamily="@font/mulish_bold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_4sdp"
                    android:paddingVertical="@dimen/_1sdp"
                    android:singleLine="true"
                    android:text="Dubbed"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_9sdp" />


                <LinearLayout
                    android:id="@+id/imageSpeedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:background="@drawable/background_back_category2"
                    android:backgroundTint="#14FFFFFF"

                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/_3sdp">

                    <ImageView
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:padding="@dimen/_1sdp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/image_fire_icon" />

                    <TextView
                        android:id="@id/textViewTotalView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/mulish_semibold"
                        android:maxLines="2"
                        android:text="11.3 M"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9ssp" />


                </LinearLayout>

            </RelativeLayout>


        </RelativeLayout>

    </androidx.cardview.widget.CardView>



    <TextView
        android:id="@+id/textSeriesName"
        android:layout_below="@+id/cardLayout"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/mulish_semibold"
        android:ellipsize="end"
        android:singleLine="true"
        android:maxLines="1"
        android:paddingTop="4dp"
        android:text="Episode Title"
        android:textColor="@color/white"
        android:textSize="@dimen/_12sdp"
        />
    <TextView
        android:id="@+id/textTagCategory"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_5sdp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_below="@+id/textSeriesName"
        android:singleLine="true"
        android:fontFamily="@font/mulish_regular"
        android:background="@drawable/background_back_category"
        android:text="True love "
        android:gravity="center_vertical"
        android:textColor="@color/white"
        android:textSize="@dimen/_10sdp" />


</RelativeLayout>