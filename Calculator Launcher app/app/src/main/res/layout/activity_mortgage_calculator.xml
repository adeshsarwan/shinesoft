<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/include_toolbar_back" />

    <include layout="@layout/include_ad_banner" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/home_price" />

                <TextView
                    android:id="@+id/tvHomePrice"
                    style="@style/InputBox"
                    android:background="@drawable/bg_result_box"
                    android:text="@string/zero_money" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/down_payment" />

                <LinearLayout
                    android:layout_width="160dp"
                    android:layout_height="44dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDownPayment"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_result_box"
                        android:gravity="center_vertical|end"
                        android:paddingHorizontal="10dp"
                        android:text="@string/zero_money"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:id="@+id/fieldDownType"
                        android:layout_width="52dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_result_box"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDownType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="%"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_dropdown" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/loan_term" />

                <LinearLayout
                    android:id="@+id/fieldLoanTerm"
                    style="@style/InputBox"
                    android:background="@drawable/bg_result_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLoanTerm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="30 Year"
                        android:textColor="@color/text_primary" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_dropdown" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/interest_rate" />

                <TextView
                    android:id="@+id/tvInterestRate"
                    style="@style/InputBox"
                    android:background="@drawable/bg_result_box"
                    android:text="@string/zero_percent" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowTaxesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/taxes_costs"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivTaxesArrow"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_dropdown" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/taxesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="@string/property_tax" />

                    <TextView
                        android:id="@+id/tvPropertyTax"
                        style="@style/InputBox"
                        android:background="@drawable/bg_result_box"
                        android:text="@string/zero_money" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="@string/home_insurance" />

                    <TextView
                        android:id="@+id/tvInsurance"
                        style="@style/InputBox"
                        android:background="@drawable/bg_result_box"
                        android:text="@string/zero_money" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/monthly_payment"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <LinearLayout
                    style="@style/ResultBox"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dollar"
                        android:textColor="@color/text_hint" />

                    <TextView
                        android:id="@+id/tvMonthlyResult"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/zero_money"
                        android:textColor="@color/text_green"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/total_payable"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <LinearLayout
                    style="@style/ResultBox"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dollar"
                        android:textColor="@color/text_hint" />

                    <TextView
                        android:id="@+id/tvTotalResult"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/zero_money"
                        android:textColor="@color/text_green"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:padding="8dp">

        <TextView
            android:id="@+id/key7"
            style="@style/KeyButton"
            android:text="7" />

        <TextView
            android:id="@+id/key8"
            style="@style/KeyButton"
            android:text="8" />

        <TextView
            android:id="@+id/key9"
            style="@style/KeyButton"
            android:text="9" />

        <ImageView
            android:id="@+id/keyBackspace"
            style="@style/KeyButton.Danger"
            android:contentDescription="@null"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_backspace" />

        <TextView
            android:id="@+id/key4"
            style="@style/KeyButton"
            android:text="4" />

        <TextView
            android:id="@+id/key5"
            style="@style/KeyButton"
            android:text="5" />

        <TextView
            android:id="@+id/key6"
            style="@style/KeyButton"
            android:text="6" />

        <TextView
            android:id="@+id/keyClear"
            style="@style/KeyButton.Danger"
            android:text="@string/clear"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/key1"
            style="@style/KeyButton"
            android:text="1" />

        <TextView
            android:id="@+id/key2"
            style="@style/KeyButton"
            android:text="2" />

        <TextView
            android:id="@+id/key3"
            style="@style/KeyButton"
            android:text="3" />

        <ImageView
            android:id="@+id/keyReset"
            style="@style/KeyButton.Danger"
            android:contentDescription="@null"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_reset" />

        <TextView
            android:id="@+id/key0"
            style="@style/KeyButton"
            android:text="0" />

        <TextView
            android:id="@+id/keyDot"
            style="@style/KeyButton"
            android:text="@string/dot" />

        <TextView
            android:id="@+id/btnCalculate"
            style="@style/KeyButton.Equals"
            android:layout_columnSpan="2"
            android:text="@string/calculate"
            android:textSize="16sp" />
    </GridLayout>
</LinearLayout>
