<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    >

    <LinearLayout
        android:padding="@dimen/_5sdp"
        android:layout_width="@dimen/_105sdp"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_7sdp">

                <ImageView
                    android:id="@+id/imageSeries"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:maxHeight="@dimen/_150sdp"
                    android:scaleType="fitXY" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradiant_border"
                    android:rotation="180" />

                <TextView
                    android:id="@+id/freeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_margin="@dimen/_4sdp"

                    android:padding="@dimen/_3sdp"
                    android:text="@string/free"
                    android:textColor="@color/whiteMy"
                    android:textSize="@dimen/_8sdp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textViews"
                    android:layout_width="wrap_content"
                    android:visibility="invisible"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/ic_btn"
                    android:drawableStart="@drawable/eye2"

                    android:drawablePadding="@dimen/_3sdp"
                    android:drawableTint="@color/whiteMy"
                    android:gravity="center_vertical"
                    android:textColor="@color/whiteMy"
                    android:textSize="@dimen/_8sdp" />

                <TextView
                    android:id="@+id/textEpisodesNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:layout_margin="@dimen/_5sdp"
                    android:fontFamily="@font/mulish_bold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_4sdp"
                    android:paddingVertical="@dimen/_1sdp"
                    android:singleLine="true"
                    android:text="EP. 02"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_9sdp" />


                <LinearLayout
                    android:id="@+id/imageSpeedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|right"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:layout_marginEnd="@dimen/_5sdp"


                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    >

                    <ImageView
                        android:layout_width="@dimen/_11sdp"
                        android:layout_height="@dimen/_11sdp"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:padding="@dimen/_2sdp"
                        android:adjustViewBounds="true"
                        android:tint="@color/white"
                        android:src="@drawable/image_play_button" />

                    <TextView
                        android:id="@+id/textViewTotalView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_1sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/mulish_bold"
                        android:maxLines="2"
                        android:text="3.5 M"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9ssp" />


                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressContinue"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_below="@id/relative"
                    android:layout_gravity="bottom"

                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:background="@color/white"
                    android:progressBackgroundTint="@color/white"
                    android:progressTint="@color/app_colors" />


            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_margin="4dp"
                android:background="@drawable/ic_btn"
                android:padding="2dp"
                android:text="@string/_new"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:visibility="gone" />



        </FrameLayout>

        <TextView
            android:id="@+id/textSeriesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mulish_semibold"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingTop="4dp"
            android:text="Episode Title"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sdp"
            />
    </LinearLayout>



</LinearLayout>
