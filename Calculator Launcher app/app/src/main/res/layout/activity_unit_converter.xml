<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/include_toolbar_back" />

    <include layout="@layout/include_ad_banner" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/categoryTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/tabArea"
                style="@style/CategoryTab"
                android:text="@string/cat_area" />

            <TextView
                android:id="@+id/tabLength"
                style="@style/CategoryTab.Active"
                android:text="@string/cat_length" />

            <TextView
                android:id="@+id/tabTemperature"
                style="@style/CategoryTab"
                android:text="@string/cat_temperature" />

            <TextView
                android:id="@+id/tabVolume"
                style="@style/CategoryTab"
                android:text="@string/cat_volume" />

            <TextView
                android:id="@+id/tabMass"
                style="@style/CategoryTab"
                android:text="@string/cat_mass" />

            <TextView
                android:id="@+id/tabData"
                style="@style/CategoryTab"
                android:text="@string/cat_data" />

            <TextView
                android:id="@+id/tabSpeed"
                style="@style/CategoryTab"
                android:text="@string/cat_speed" />

            <TextView
                android:id="@+id/tabTime"
                style="@style/CategoryTab"
                android:text="@string/cat_time" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_convert_card"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rowFrom"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:id="@+id/fromUnitDrop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvFromUnit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Inches (in)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/unit"
                    android:src="@drawable/ic_dropdown" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvFromValue"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_input_focus"
                android:gravity="center_vertical|end"
                android:minWidth="80dp"
                android:paddingHorizontal="10dp"
                android:text="1.00"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/rowTo"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:id="@+id/toUnitDrop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvToUnit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Centimeters (cm)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/unit"
                    android:src="@drawable/ic_dropdown" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvToValue"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center_vertical|end"
                android:minWidth="80dp"
                android:paddingHorizontal="10dp"
                android:text="2.54"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include
        android:id="@+id/keypadInclude"
        layout="@layout/include_keypad" />
</LinearLayout>
