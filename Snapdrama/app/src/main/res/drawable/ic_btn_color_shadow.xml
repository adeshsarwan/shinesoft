<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/black"/>
            <corners android:radius="@dimen/_10sdp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#00ff0000" android:endColor="#1affffff" android:angle="180" android:centerX="0.9" android:centerColor="#00ff0000"/>
            <corners android:radius="@dimen/_10sdp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#00ff0000" android:endColor="#1affffff" android:angle="0" android:centerX="0.9" android:centerColor="#00ff0000"/>
            <corners android:radius="@dimen/_10sdp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1affffff" android:endColor="#00e9e9e9" android:angle="270" android:centerY="0.2" android:centerColor="#19000000"/>
            <corners android:radius="@dimen/_10sdp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1affffff" android:endColor="#00ff0000" android:angle="90" android:centerY="0.2" android:centerColor="#0dffffff"/>
            <corners android:radius="@dimen/_10sdp"/>
        </shape>
    </item>
</layer-list>
