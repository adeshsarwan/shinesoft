<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_10sdp"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_125sdp"
        android:layout_margin="@dimen/_5sdp"
        android:background="@drawable/background_new_list2"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:adjustViewBounds="true"
            android:src="@drawable/image_background_new" />

        <androidx.cardview.widget.CardView

            android:id="@+id/cardLayout"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_115sdp"
            android:layout_marginVertical="@dimen/_7sdp"
            android:layout_marginStart="@dimen/_7sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:elevation="0dp"
            app:cardBackgroundColor="@color/black"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">


                <RelativeLayout
                    android:id="@+id/mainLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imageSeries"
                        android:layout_width="@dimen/_90sdp"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:scaleType="centerCrop" />


                </RelativeLayout>


            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@+id/cardLayout"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/watchVideo"

                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:fontFamily="@font/mulish_bold"
                    android:gravity="start"
                    android:singleLine="true"
                    android:text="@string/watch_video"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_14sdp"
                    android:textStyle="normal" />
                <TextView
                    android:id="@+id/buttonSkip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:fontFamily="@font/mulish_bold"
                    android:gravity="start"
                    android:singleLine="true"
                    android:text="@string/skip"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="normal" />

            </LinearLayout>


            <TextView
                android:id="@+id/textView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:fontFamily="@font/mulish_semibold"
                android:gravity="start"
                android:layout_below="@+id/watchVideo"
                android:singleLine="true"
                android:text="I love your fiancé's uncle"
                android:textColor="@color/white"
                android:textSize="@dimen/_11sdp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"

                android:layout_height="wrap_content"
                android:layout_below="@id/textView1"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_3sdp"
                android:fontFamily="@font/mulish_medium"
                android:gravity="start"
                android:maxLines="2"
                android:text="She is forced to become engaged to a fool to save her mother and ends up..."
                android:textColor="#8E8C8C"
                android:textSize="@dimen/_10sdp"
                android:textStyle="normal" />

            <!-- Free unlock attempts label -->


        </RelativeLayout>

    </RelativeLayout>


</RelativeLayout>