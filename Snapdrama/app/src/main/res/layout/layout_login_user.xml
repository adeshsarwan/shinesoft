<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical">
<!--<ImageView-->
<!--    android:layout_width="match_parent"-->
<!--    android:layout_height="wrap_content"-->
<!--    android:src="@drawable/bg_dialog_view"/>-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_save_list"
        android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:ellipsize="end"
        android:fontFamily="@font/mulish_semibold"
        android:gravity="center"
        android:maxLines="2"
        android:paddingTop="4dp"
        android:text="@string/save_your_list"
        android:textColor="@color/white"
        android:textSize="@dimen/_15sdp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:ellipsize="end"
        android:fontFamily="@font/mulish_medium"
        android:gravity="center"
        android:maxLines="2"
        android:paddingTop="4dp"
        android:text="@string/save_your_list_des"
        android:textColor="#7B7B7B"
        android:textSize="@dimen/_12sdp"
        android:visibility="gone" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:visibility="gone">


        <LinearLayout
            android:id="@+id/linearNumberLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="@dimen/_10sdp"

            android:orientation="horizontal"
            android:visibility="gone">

            <com.hbb20.CountryCodePicker
                android:id="@+id/ccp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/background_episode_num"
                android:backgroundTint="@color/black"
                android:paddingVertical="@dimen/_6sdp"
                app:ccp_autoDetectCountry="true"
                app:ccp_contentColor="@color/grey_colors"
                app:ccp_defaultNameCode="IN"
                app:ccp_showFlag="true"
                app:ccp_showPhoneCode="true" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:background="@drawable/background_episode_num"
                android:backgroundTint="@color/black"
                android:drawablePadding="12dp"
                android:fontFamily="@font/mulish_medium"

                android:hint="@string/enter_your_mobile_number"
                android:inputType="phone"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_13sdp"
                android:textColor="@color/white"
                android:textColorHint="@color/grey_colors"
                android:textSize="@dimen/_13sdp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutOtpBoxes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/etOtp1"
                android:layout_width="0dp"
                android:layout_height="@dimen/_45sdp"
                android:layout_weight="1"
                android:autofillHints="oneTimeCode"
                android:background="@drawable/background_mobile_number"
                android:fontFamily="@font/mulish_medium"
                android:gravity="center"

                android:importantForAutofill="yes"
                android:inputType="number"
                android:maxLength="1"
                android:paddingVertical="@dimen/_8sdp"
                android:textColor="@color/white"
                android:textColorHint="@color/grey_colors"
                android:textSize="@dimen/_14sdp" />

            <Space
                android:layout_width="@dimen/_8sdp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/etOtp2"
                android:layout_width="0dp"
                android:layout_height="@dimen/_45sdp"
                android:layout_weight="1"
                android:background="@drawable/background_episode_num"
                android:fontFamily="@font/mulish_medium"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:paddingVertical="@dimen/_8sdp"
                android:textColor="@color/white"
                android:textColorHint="@color/grey_colors"
                android:textSize="@dimen/_14sdp" />

            <Space
                android:layout_width="@dimen/_8sdp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/etOtp3"
                android:layout_width="0dp"
                android:layout_height="@dimen/_45sdp"
                android:layout_weight="1"
                android:background="@drawable/background_episode_num"
                android:fontFamily="@font/mulish_medium"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:paddingVertical="@dimen/_8sdp"
                android:textColor="@color/white"
                android:textColorHint="@color/grey_colors"
                android:textSize="@dimen/_14sdp" />

            <Space
                android:layout_width="@dimen/_8sdp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/etOtp4"
                android:layout_width="0dp"
                android:layout_height="@dimen/_45sdp"
                android:layout_weight="1"
                android:background="@drawable/background_episode_num"
                android:fontFamily="@font/mulish_medium"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:paddingVertical="@dimen/_8sdp"
                android:textColor="@color/white"
                android:textColorHint="@color/grey_colors"
                android:textSize="@dimen/_14sdp" />

            <Space
                android:layout_width="@dimen/_8sdp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/etOtp5"
                android:layout_width="0dp"
                android:layout_height="@dimen/_45sdp"
                android:layout_weight="1"
                android:background="@drawable/background_episode_num"
                android:fontFamily="@font/mulish_medium"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:paddingVertical="@dimen/_8sdp"
                android:textColor="@color/white"
                android:textColorHint="@color/grey_colors"
                android:textSize="@dimen/_14sdp" />

            <Space
                android:layout_width="@dimen/_8sdp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/etOtp6"
                android:layout_width="0dp"
                android:layout_height="@dimen/_45sdp"
                android:layout_weight="1"
                android:background="@drawable/background_episode_num"
                android:fontFamily="@font/mulish_medium"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:paddingVertical="@dimen/_8sdp"
                android:textColor="@color/white"
                android:textColorHint="@color/grey_colors"
                android:textSize="@dimen/_14sdp" />

        </LinearLayout>


    </RelativeLayout>


    <TextView
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:background="@drawable/background_login_button"
        android:fontFamily="@font/mulish_semibold"
        android:gravity="center"
        android:paddingVertical="@dimen/_8sdp"
        android:text="@string/confirm"
        android:textColor="@color/white"
        android:textSize="@dimen/_14sdp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:ellipsize="end"
        android:fontFamily="@font/mulish_medium"
        android:gravity="center"
        android:maxLines="2"
        android:paddingTop="4dp"
        android:text="- OR -"
        android:textColor="#7B7B7B"
        android:textSize="@dimen/_12sdp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:orientation="vertical">


        <ImageView
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_above="@+id/loginText"
            android:layout_gravity="center"
            android:src="@drawable/image_circle_login_icon" />

        <TextView
            android:id="@+id/loginText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/mulish_semibold"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="@dimen/_15sdp" />

        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/buttonSingInGoogle"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/_30sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            android:fontFamily="@font/mulish_semibold"
            android:gravity="center"
            android:paddingVertical="@dimen/_10sdp"
            android:text="@string/sign_in_with_google_for"
            android:textColor="#75787D"
            android:textSize="@dimen/_10sdp" />


        <LinearLayout
            android:id="@+id/bottomView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">


            <LinearLayout
                android:id="@+id/signInGoogle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:background="@drawable/background_login_button"
                android:backgroundTint="#FFFFFF"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/_10sdp">

                <ImageView
                    android:layout_width="@dimen/_21sdp"
                    android:layout_height="@dimen/_21sdp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/image_google_sign_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:fontFamily="@font/mulish_semibold"
                    android:singleLine="true"
                    android:text="@string/sign_in_with_google"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_13sdp"
                    android:textStyle="normal" />
            </LinearLayout>

            <ImageView
                android:id="@+id/signInFacebook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:adjustViewBounds="true"
                android:src="@drawable/image_facebook_icon"
                android:visibility="gone" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:ellipsize="end"
                android:fontFamily="@font/mulish_semibold"
                android:gravity="center"
                android:maxLines="2"
                android:paddingTop="4dp"
                android:text="@string/by_continue_you_agree"
                android:textColor="#7B7B7B"
                android:textSize="@dimen/_10sdp" />

            <LinearLayout
                android:id="@+id/linearPrivacyTermOfUse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/_10sdp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:ellipsize="end"
                    android:fontFamily="@font/mulish_semibold"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/term1"
                    android:textColor="@color/app_colors"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/mulish_medium"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="&amp;"
                    android:textColor="#7B7B7B"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:ellipsize="end"
                    android:fontFamily="@font/mulish_semibold"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/term2"
                    android:textColor="@color/app_colors"
                    android:textSize="@dimen/_10sdp" />


            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/buttonClose"
        android:layout_width="@dimen/_24sdp"
        android:layout_height="@dimen/_24sdp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:padding="@dimen/_4sdp"
        android:src="@drawable/image_close_button" />

</RelativeLayout>