<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="wrap_content">


    <RelativeLayout
        android:layout_width="match_parent"
        android:paddingVertical="@dimen/_10sdp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/black"
        android:background="@drawable/background_exit_dialogs">

        <TextView
            android:id="@+id/textView1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="normal"
            android:gravity="center"
            android:layout_marginBottom="@dimen/_5sdp"
            android:layout_gravity="center_vertical"
            android:textColor="@color/white"
            android:singleLine="true"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:textSize="@dimen/_16sdp"
            android:fontFamily="@font/mulish_bold"
            android:text="@string/more_dramas"
            />

        <androidx.viewpager2.widget.ViewPager2
            android:layout_below="@+id/textView1"
            android:id="@+id/viewPager2"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_height="@dimen/_220sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:paddingHorizontal="80dp"/>

        <TextView
            android:id="@+id/textViewSeriesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="normal"
            android:gravity="center"
            android:layout_below="@+id/viewPager2"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_gravity="center_vertical"
            android:textColor="@color/white"
            android:singleLine="true"
            android:layout_marginStart="@dimen/_30sdp"
            android:layout_marginEnd="@dimen/_30sdp"
            android:textSize="@dimen/_13sdp"
            android:fontFamily="@font/mulish_bold"
            android:text="Kissing the Wrong Brother"
            />
        <TextView
            android:id="@+id/textSeriesDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="normal"
            android:layout_below="@+id/textViewSeriesTitle"
            android:layout_gravity="center_vertical"
            android:textColor="#818181"
            android:layout_marginTop="@dimen/_3sdp"
            android:gravity="center_horizontal"
            android:lines="2"
            android:layout_marginStart="@dimen/_30sdp"
            android:layout_marginEnd="@dimen/_30sdp"
            android:textSize="@dimen/_10sdp"
            android:fontFamily="@font/mulish_medium"
            android:text="Forbidden Love, Love Tringle"
            />

        <LinearLayout
            android:layout_below="@+id/textSeriesDescription"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/textExit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/background_exit_button_grey"
                android:paddingHorizontal="@dimen/_20sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:textStyle="normal"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:textColor="@color/white"
                android:singleLine="true"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:textSize="@dimen/_13sdp"
                android:fontFamily="@font/mulish_bold"
                android:text="@string/exit"
                />

            <TextView
                android:id="@+id/textWatch"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/background_exit_button"
                android:paddingHorizontal="@dimen/_20sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:textStyle="normal"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:textColor="@color/white"
                android:singleLine="true"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                android:textSize="@dimen/_13sdp"
                android:fontFamily="@font/mulish_bold"
                android:text="@string/watch"
                />
        </LinearLayout>

    </RelativeLayout>



</RelativeLayout>



