<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    app:riv_corner_radius="12dp"

    android:layout_height="match_parent">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:background="@drawable/shimmer_bg_rounded"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true"
        app:shimmer_duration="1200">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1E1E1E">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shimmer_bg_rounded" />

            <View
                android:layout_width="140dp"
                android:layout_height="14dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="76dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/shimmer_bg_small" />

            <View
                android:layout_width="200dp"
                android:layout_height="12dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="56dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/shimmer_bg_small" />

            <View
                android:layout_width="110dp"
                android:layout_height="32dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="12dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/shimmer_bg_button" />

        </RelativeLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <RelativeLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/imageSlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    app:riv_corner_radius="12dp"
                    android:scaleType="centerCrop" />


                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/background_black_shadow2"
                    />


            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_alignParentBottom="true"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/textTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/white"
                    android:singleLine="true"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:textSize="@dimen/_12sdp"
                    android:fontFamily="@font/mulish_bold"
                    android:text="I love your fiancé's uncle"
                    />
                <TextView
                    android:id="@+id/textDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:textColor="#999999"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:textSize="@dimen/_10sdp"
                    android:fontFamily="@font/mulish_medium"
                    android:text="She is forced to become engaged to a fool to save her mother and ends up..."
                    />


                <TextView
                    android:id="@+id/buttonWatchNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:paddingVertical="@dimen/_6sdp"

                    android:drawablePadding="@dimen/_7sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:drawableStart="@drawable/image_play_button"
                    android:layout_gravity="center_horizontal"


                    android:layout_marginTop="@dimen/_5sdp"
                    android:gravity="center"
                    android:background="@drawable/background_watch_now"
                    android:maxLines="2"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:textColor="@color/black"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:textSize="@dimen/_12sdp"
                    android:fontFamily="@font/mulish_bold"
                    android:text="@string/watch_now"
                    />


            </LinearLayout>


        </RelativeLayout>


    </RelativeLayout>

</FrameLayout>
