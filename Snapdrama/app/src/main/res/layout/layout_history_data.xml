<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    app:cardElevation="0dp"
    app:cardCornerRadius="@dimen/_10sdp"
    android:layout_marginTop="@dimen/_5sdp"
    app:cardBackgroundColor="@color/black"
    android:layout_marginBottom="@dimen/_5sdp"
    android:layout_marginHorizontal="@dimen/_5sdp"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:background="@drawable/background_new_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:adjustViewBounds="true"
            android:src="@drawable/image_background_new" />


    <RelativeLayout
        android:id="@+id/relative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal">


        <androidx.cardview.widget.CardView

            android:id="@+id/cardLayout"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_75sdp"
            android:layout_marginVertical="@dimen/_6sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:elevation="0dp"
            app:cardBackgroundColor="@color/black"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">


                <RelativeLayout
                    android:id="@+id/mainLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imageSeries"
                        android:layout_width="@dimen/_60sdp"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:scaleType="centerCrop" />


                </RelativeLayout>


            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <RelativeLayout
            android:layout_toStartOf="@id/rl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/cardLayout"
            android:orientation="vertical">


            <TextView
                android:id="@+id/textSeriesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:fontFamily="@font/mulish_semibold"
                android:gravity="start"
                android:singleLine="true"
                android:text="I love your fiancé's uncle"
                android:textColor="@color/white"
                android:textSize="@dimen/_13sdp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"

                android:layout_height="wrap_content"
                android:layout_below="@id/textSeriesTitle"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_3sdp"
                android:fontFamily="@font/mulish_medium"
                android:gravity="start"
                android:singleLine="true"
                android:text="Billionaire, Strong Heroine"
                android:textColor="#8E8C8C"
                android:textSize="@dimen/_10sdp"
                android:textStyle="normal" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_centerVertical="true"

            android:layout_marginBottom="@dimen/_10sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/linearEpisode"
                android:layout_width="wrap_content"
                android:background="@drawable/background_history_category_black"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:padding="@dimen/_5sdp"
                android:visibility="gone"


                android:backgroundTint="@color/black"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/play_cur"
                    android:layout_width="wrap_content"
                    android:fontFamily="@font/mulish_medium"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="@dimen/_5sdp"
                    android:text="EP.1"
                    android:textColor="@color/grey_colors"
                    android:textSize="@dimen/_10ssp" />

                <TextView
                    android:id="@+id/play_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mulish_medium"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:text="/EP.50"
                    android:textColor="@color/grey_colors"
                    android:textSize="@dimen/_10ssp" />

            </LinearLayout>
            <LinearLayout
                android:id="@+id/linearMYListEpisode"
                android:layout_width="wrap_content"
                android:background="@drawable/background_history_category_black"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_centerVertical="true"
                android:visibility="gone"

                android:padding="@dimen/_5sdp"


                android:backgroundTint="@color/black"
                android:orientation="horizontal">



                <TextView
                    android:id="@+id/textMYListEpisode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mulish_medium"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:text="EP.50"
                    android:textColor="@color/grey_colors"
                    android:textSize="@dimen/_10ssp" />

            </LinearLayout>
        </RelativeLayout>


    </RelativeLayout>

    <ProgressBar
        android:id="@+id/progressContinue"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_below="@id/relative"

        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@color/white"
        android:progressTint="@color/app_colors" />

    </RelativeLayout>


</androidx.cardview.widget.CardView>