<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/homeContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/SmallNative">


        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/image_header_background2">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="#240B12"
                app:layout_scrollFlags="scroll|snap|exitUntilCollapsed">

                <LinearLayout
                    android:id="@+id/extralayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_50sdp"
                    android:orientation="vertical"
                    app:layout_collapseMode="parallax">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/suggestionContainer"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/_40sdp"
                            android:clipChildren="false"
                            android:clipToPadding="false" />

                        <EditText
                            android:id="@+id/editSearchScreen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/background_search"
                            android:drawableLeft="@drawable/image_search_icon"
                            android:drawablePadding="@dimen/_10sdp"
                            android:fontFamily="@font/mulish_semibold"
                            android:inputType="none"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:paddingVertical="@dimen/_7sdp"
                            android:paddingStart="@dimen/_10sdp"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white"
                            android:textSize="@dimen/_13sdp"
                            android:textStyle="normal" />
                    </RelativeLayout>

                    <HorizontalScrollView
                        android:id="@+id/horizontalScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RelativeLayout
                                android:id="@+id/imgViewCategory1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_7sdp">

                                <ImageView
                                    android:id="@+id/imgView1"
                                    android:layout_width="@dimen/_82sdp"
                                    android:layout_height="wrap_content"
                                    android:adjustViewBounds="true"
                                    android:src="@drawable/ic_tab_select" />

                                <TextView
                                    android:layout_width="@dimen/_82sdp"
                                    android:layout_height="match_parent"
                                    android:layout_centerInParent="true"
                                    android:fontFamily="@font/mulish_semibold"
                                    android:gravity="center"
                                    android:text="@string/popular"
                                    android:singleLine="true"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/_12sdp" />

                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/imgViewCategory2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_7sdp">

                                <ImageView
                                    android:id="@+id/imgView2"
                                    android:layout_width="@dimen/_82sdp"
                                    android:layout_height="wrap_content"
                                    android:adjustViewBounds="true"
                                    android:src="@drawable/ic_tab_unselect" />

                                <TextView
                                    android:layout_width="@dimen/_82sdp"
                                    android:layout_height="match_parent"
                                    android:layout_centerInParent="true"
                                    android:fontFamily="@font/mulish_semibold"
                                    android:gravity="center"
                                    android:text="@string/new_"
                                    android:singleLine="true"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/_12sdp" />

                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/imgViewCategory3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_7sdp">

                                <ImageView
                                    android:id="@+id/imgView3"
                                    android:layout_width="@dimen/_82sdp"
                                    android:layout_height="wrap_content"
                                    android:adjustViewBounds="true"
                                    android:src="@drawable/ic_tab_unselect" />

                                <TextView
                                    android:layout_width="@dimen/_82sdp"
                                    android:layout_height="match_parent"
                                    android:layout_centerInParent="true"
                                    android:fontFamily="@font/mulish_semibold"
                                    android:gravity="center"
                                    android:singleLine="true"
                                    android:text="@string/ranking"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/_12sdp" />

                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/imgViewCategory5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_7sdp">

                                <ImageView
                                    android:id="@+id/imgView5"
                                    android:layout_width="@dimen/_82sdp"
                                    android:layout_height="wrap_content"
                                    android:adjustViewBounds="true"
                                    android:src="@drawable/ic_tab_unselect" />

                                <TextView
                                    android:layout_width="@dimen/_82sdp"
                                    android:layout_height="match_parent"
                                    android:layout_centerInParent="true"
                                    android:fontFamily="@font/mulish_semibold"
                                    android:gravity="center"
                                    android:singleLine="true"
                                    android:text="@string/categories"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/_12sdp" />

                            </RelativeLayout>


                            <!--                            <ImageView-->
                            <!--                              -->
                            <!--                                android:layout_width="@dimen/_80sdp"-->
                            <!--                                android:layout_height="wrap_content"-->
                            <!--                                android:layout_marginStart="@dimen/_7sdp"-->
                            <!--                                android:adjustViewBounds="true"-->
                            <!--                                android:src="@drawable/image_cate_popular_select" />-->

                            <!--                            <ImageView-->
                            <!--                                android:id="@+id/imgViewCategory2"-->
                            <!--                                android:layout_width="@dimen/_80sdp"-->
                            <!--                                android:layout_height="wrap_content"-->
                            <!--                                android:layout_marginStart="@dimen/_7sdp"-->
                            <!--                                android:adjustViewBounds="true"-->
                            <!--                                android:src="@drawable/image_cate_new_unselect" />-->

                            <!--                            <ImageView-->
                            <!--                                android:id="@+id/imgViewCategory3"-->

                            <!--                                android:layout_width="@dimen/_80sdp"-->
                            <!--                                android:layout_height="wrap_content"-->
                            <!--                                android:layout_marginStart="@dimen/_7sdp"-->
                            <!--                                android:adjustViewBounds="true"-->
                            <!--                                android:src="@drawable/image_cate_ranking_unselect" />-->

                            <!--                            <ImageView-->
                            <!--                                android:id="@+id/imgViewCategory5"-->

                            <!--                                android:layout_width="@dimen/_80sdp"-->
                            <!--                                android:layout_height="wrap_content"-->
                            <!--                                android:layout_marginStart="@dimen/_7sdp"-->
                            <!--                                android:adjustViewBounds="true"-->
                            <!--                                android:src="@drawable/image_cate_categories_unselect" />-->


                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>


                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/linearCustomToolBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/_7sdp"
                    app:layout_collapseMode="pin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="wrap_content"

                            android:layout_gravity="center_vertical"
                            android:adjustViewBounds="true"
                            android:src="@drawable/image_splash_logo_witout_bac" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/mulish_bold"
                            android:text="Snap Drama"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15sdp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/buttonPremium"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_30sdp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginEnd="@dimen/_10sdp"
                                android:adjustViewBounds="true"

                                android:src="@drawable/image_premium" />

                            <ImageView
                                android:id="@+id/buttonStrike"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_30sdp"
                                android:layout_marginEnd="@dimen/_10sdp"
                                android:adjustViewBounds="true"

                                android:src="@drawable/image_strake"

                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>


                </androidx.appcompat.widget.Toolbar>


            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPagerHomeFrag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />


    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <LinearLayout
        android:id="@+id/SmallNative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:visibility="gone">

            <com.snapdrama.shortstream.ads.SmallBannerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

    </LinearLayout>

</RelativeLayout>