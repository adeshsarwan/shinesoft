<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg"
    android:orientation="vertical"
    tools:context=".activity.login.LoginMainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/linear"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/_10sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.hbb20.CountryCodePicker
                            android:id="@+id/ccp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/background_episode_num"
                            android:paddingVertical="@dimen/_6sdp"
                            app:ccp_autoDetectCountry="true"
                            app:ccp_contentColor="@color/grey_colors"
                            app:ccp_defaultNameCode="IN"
                            app:ccp_showFlag="true"
                            app:ccp_showPhoneCode="true" />

                        <EditText
                            android:id="@+id/etPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:background="@drawable/background_episode_num"
                            android:drawablePadding="12dp"
                            android:fontFamily="@font/mulish_medium"
                            android:hint="@string/enter_your_mobile_number"
                            android:inputType="phone"
                            android:paddingHorizontal="@dimen/_9sdp"
                            android:paddingVertical="@dimen/_13sdp"
                            android:textColor="@color/white"
                            android:textColorHint="@color/grey_colors"
                            android:textSize="@dimen/_13sdp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnLoginPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:background="@drawable/background_login_button"
                        android:fontFamily="@font/mulish_semibold"
                        android:gravity="center"
                        android:paddingVertical="@dimen/_10sdp"
                        android:text="@string/continues"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_12sdp" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_15sdp"
                        android:gravity="center"
                        android:visibility="gone"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#333333" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="12dp"
                            android:fontFamily="@font/mulish_medium"
                            android:text="@string/or"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12sdp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#333333" />

                    </LinearLayout>


                </LinearLayout>

            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/_90sdp"
            android:layout_height="@dimen/_90sdp"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"
            android:layout_above="@+id/loginText"
            android:src="@drawable/image_circle_login_icon" />


        <TextView
            android:id="@+id/loginText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_above="@+id/description"
            android:gravity="center"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/mulish_semibold"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="@dimen/_15sdp" />

        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/_30sdp"
            android:fontFamily="@font/mulish_semibold"
            android:layout_marginBottom="@dimen/_12sdp"
            android:layout_above="@+id/buttonSingInGoogle"
            android:gravity="center"
            android:paddingVertical="@dimen/_10sdp"
            android:text="@string/sign_in_with_google_for"
            android:textColor="#75787D"
            android:textSize="@dimen/_10sdp" />

        <LinearLayout
            android:id="@+id/buttonSingInGoogle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_above="@+id/bottomView"
            android:layout_marginBottom="@dimen/_20sdp"
            android:padding="@dimen/_10sdp"
            android:background="@drawable/background_login_button"
            android:backgroundTint="#FFFFFF"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/_21sdp"
                android:layout_height="@dimen/_21sdp"
                android:src="@drawable/image_google_sign_icon"
                android:adjustViewBounds="true" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/mulish_bold"
                android:singleLine="true"
                android:text="@string/sign_in_with_google"
                android:layout_marginStart="@dimen/_10sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal" />
        </LinearLayout>


        <TextView
            android:id="@+id/buttonSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_gravity="center"
            android:layout_margin="12dp"
            android:background="@drawable/background_skip_button"
            android:fontFamily="@font/mulish_medium"
            android:paddingHorizontal="@dimen/_18sdp"
            android:paddingVertical="@dimen/_6sdp"
            android:text="@string/skip"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sdp" />

        <LinearLayout
            android:id="@+id/bottomView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/_10sdp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:ellipsize="end"
                android:fontFamily="@font/mulish_semibold"
                android:gravity="center"
                android:maxLines="2"
                android:paddingTop="4dp"
                android:text="@string/by_continue_you_agree"
                android:textColor="#7B7B7B"
                android:textSize="@dimen/_10sdp" />

            <LinearLayout
                android:id="@+id/linearPrivacyTermOfUse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/_5sdp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:ellipsize="end"
                    android:fontFamily="@font/mulish_semibold"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingTop="4dp"
                    android:text="@string/term1"
                    android:textColor="@color/app_colors"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:ellipsize="end"
                    android:fontFamily="@font/mulish_medium"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingTop="4dp"
                    android:text="&amp;"
                    android:textColor="#7B7B7B"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:ellipsize="end"
                    android:fontFamily="@font/mulish_semibold"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingTop="4dp"
                    android:text="@string/term2"
                    android:textColor="@color/app_colors"
                    android:textSize="@dimen/_10sdp" />


            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/linearSmallBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerAdsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.2"
            app:shimmer_highlight_alpha="0.6"
            app:shimmer_highlight_color="#FFFFFF"
            app:shimmer_repeat_mode="restart"
            app:shimmer_repeat_count="-1">

            <include layout="@layout/ads_small_native_ban_shimmer"/>

        </com.facebook.shimmer.ShimmerFrameLayout>

        <LinearLayout
            android:id="@+id/linearSmallNtv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical"/>

    </LinearLayout>


</LinearLayout>
