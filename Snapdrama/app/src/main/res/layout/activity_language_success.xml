<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_language_set_success" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/_10sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingRight="@dimen/_10sdp"
            android:paddingBottom="@dimen/_10sdp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@null"
                android:src="@drawable/image_back_scn_icon"
                app:tint="@color/whiteMy" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mulish_semibold"
                android:gravity="center"
                android:text="@string/language"
                android:textColor="@color/white"
                android:textSize="@dimen/_15sdp" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:shimmer_auto_start="true"
                app:shimmer_base_alpha="1.0"
                app:shimmer_highlight_alpha="0.6"
                app:shimmer_highlight_color="#FFFFFF"
                app:shimmer_repeat_count="-1"
                app:shimmer_repeat_mode="restart">

                <TextView
                    android:id="@+id/tvNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_back_category4"
                    android:fontFamily="@font/mulish_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_6sdp"
                    android:text="@string/next"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_13sdp" />

            </com.facebook.shimmer.ShimmerFrameLayout>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_20sdp">

            <ImageView
                android:layout_width="@dimen/_320sdp"
                android:layout_height="@dimen/_250sdp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/lang_set" />

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:visibility="gone"
                android:background="@drawable/bg_language_pref_saved_circle">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_language_pref_saved_check" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_28sdp"
                android:fontFamily="@font/mulish_bold"
                android:gravity="center"
                android:visibility="gone"
                android:includeFontPadding="false"
                android:layerType="software"
                android:lineSpacingExtra="4dp"
                android:shadowColor="#FF000000"
                android:shadowDx="2"
                android:shadowDy="3"
                android:shadowRadius="4"
                android:text="@string/language_set_successfully"
                android:textColor="@color/white"
                android:textSize="@dimen/_22sdp"
                android:textStyle="bold" />

        </LinearLayout>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerAdsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:shimmer_auto_start="true">

            <include layout="@layout/ads_small_native_ban_shimmer" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <LinearLayout
            android:id="@+id/linearSmallNtv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
