<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- LAUNCHER_MODE_START: list all installed apps in drawer -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- LAUNCHER_MODE_END -->

    <!-- LAUNCHER_MODE_START: needed to list installed apps on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <!-- LAUNCHER_MODE_END -->

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.CalculatorLauncher"
        android:usesCleartextTraffic="false">

        <!-- CALCULATOR_ONLY_START: uncomment this block and comment LAUNCHER_MODE block to disable launcher
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CalculatorLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        CALCULATOR_ONLY_END -->

        <!-- LAUNCHER_MODE_START: comment this entire block to disable phone launcher -->
        <activity
            android:name=".launcher.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CalculatorLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".launcher.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CalculatorLauncher" />

        <activity
            android:name=".launcher.LauncherHomeActivity"
            android:clearTaskOnLaunch="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.LauncherHome">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".launcher.SearchEngineActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CalculatorLauncher" />

        <activity
            android:name=".launcher.WallpaperDiscoverActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CalculatorLauncher" />

        <activity
            android:name=".launcher.CustomizeAppsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CalculatorLauncher" />

        <activity
            android:name=".launcher.LauncherSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CalculatorLauncher" />

        <activity
            android:name=".launcher.AboutMenuActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CalculatorLauncher" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CalculatorLauncher" />
        <!-- LAUNCHER_MODE_END -->

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.InfoActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.TipCalculatorActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.UnitConverterActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.CurrencyConverterActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.BmiCalculatorActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.MortgageCalculatorActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.LoanCalculatorActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.CompoundInterestActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
    </application>
</manifest>
